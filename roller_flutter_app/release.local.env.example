# Copia a `release.local.env` (NO subir a git). Usar en builds de producción:
#   flutter build web --dart-define-from-file=release.local.env
#   flutter build apk --release --dart-define-from-file=release.local.env
#   flutter build ios --release --dart-define-from-file=release.local.env
#
# Sincroniza Mapbox desde .env de desarrollo:
#   .\scripts\sync_mapbox_to_local.ps1
#   (luego copia REACT_APP_MAPBOX_ACCESS_TOKEN a este archivo)

# API en producción (HTTPS recomendado). Sin barra final.
API_BASE_URL=https://api.tudominio.com

# Mapbox (misma variable que React Native)
REACT_APP_MAPBOX_ACCESS_TOKEN=

# Opcional: alternativa a REACT_APP_*
# MAPBOX_ACCESS_TOKEN=

# Solo desarrollo local (ignorado si API_BASE_URL está definido):
# API_HOST=192.168.1.10
# API_PORT=3001
