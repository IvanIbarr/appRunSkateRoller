{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Roller · producción (main.dart)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "Roller · Chrome (Mapbox: env MAPBOX_ACCESS_TOKEN)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=MAPBOX_ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    },
    {
      "name": "Roller · Chrome (Mapbox: mapbox.local.env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/mapbox.local.env"
      ]
    }
  ]
}
