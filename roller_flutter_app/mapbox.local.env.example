# Igual que React Native (`appRunSkateRoller/src/config/mapbox.ts`): la variable típica es
# REACT_APP_MAPBOX_ACCESS_TOKEN. Flutter también acepta MAPBOX_ACCESS_TOKEN.
#
# Una sola línea con tu pk. real (https://account.mapbox.com/access-tokens/):
#   REACT_APP_MAPBOX_ACCESS_TOKEN=pk.eyJ1Ijo...
#
# Arranque Web:
#   flutter run -d chrome --dart-define-from-file=mapbox.local.env
#
# Si no pones ninguna de las dos, Flutter usa el mismo DEFAULT_TOKEN que RN (puede estar revocado → 401).

REACT_APP_MAPBOX_ACCESS_TOKEN=
