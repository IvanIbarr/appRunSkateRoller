# Copia a `.env` en SIIG-ROLLER-BACKEND (no subir .env a git).

PORT=3001
NODE_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roller_db
DB_USER=postgres
DB_PASSWORD=

# Obligatorio en producción (sin valor por defecto inseguro)
JWT_SECRET=

# Orígenes permitidos (coma separada). Ej: https://app.tudominio.com,https://tudominio.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Correo recuperación de contraseña — Resend (recomendado)
# Plan gratuito: from fijo en emailService.js → roll3rskat3roll3r <onboarding@resend.dev>
RESEND_API_KEY=
# false solo en dev si aparece UNABLE_TO_VERIFY_LEAF_SIGNATURE al llamar api.resend.com
RESEND_TLS_REJECT_UNAUTHORIZED=true

# Respaldo SMTP (opcional). Resend: host=smtp.resend.com user=resend pass=API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=roll3rskat3roll3r <onboarding@resend.dev>
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Logs cliente (opcional)
CLIENT_LOG_SECRET=
