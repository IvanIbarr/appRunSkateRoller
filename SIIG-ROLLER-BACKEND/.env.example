# Copia a `.env` en SIIG-ROLLER-BACKEND (no subir .env a git).

PORT=3001
NODE_ENV=production

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roller_db
DB_USER=postgres
DB_PASSWORD=

# Obligatorio en producción (sin valor por defecto inseguro)
JWT_SECRET=

# Orígenes permitidos (coma separada). Ej: https://app.tudominio.com,https://tudominio.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Correo recuperación de contraseña (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Logs cliente (opcional)
CLIENT_LOG_SECRET=
